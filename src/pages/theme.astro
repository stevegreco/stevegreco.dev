---
import Layout from '@/layouts/Layout.astro'
import Card from '@/components/ui/Card.astro'
import { buttonClassName } from '@/components/ui/button-variants'

interface Swatch {
  name: string
  description: string
}

const colorGroups: { title: string; swatches: Swatch[] }[] = [
  {
    title: 'Base Colors',
    swatches: [
      { name: 'background', description: 'Main background color' },
      { name: 'foreground', description: 'Main text color' },
      { name: 'card', description: 'Card background' },
      { name: 'card-foreground', description: 'Card text color' },
    ],
  },
  {
    title: 'Accent Colors',
    swatches: [
      { name: 'primary', description: 'Primary brand color' },
      { name: 'primary-foreground', description: 'Text on primary' },
      { name: 'secondary', description: 'Secondary color' },
      { name: 'secondary-foreground', description: 'Text on secondary' },
      { name: 'accent', description: 'Accent color' },
      { name: 'accent-foreground', description: 'Text on accent' },
    ],
  },
  {
    title: 'Utility Colors',
    swatches: [
      { name: 'muted', description: 'Muted background' },
      { name: 'muted-foreground', description: 'Muted text' },
      { name: 'destructive', description: 'Destructive/error color' },
      { name: 'destructive-foreground', description: 'Text on destructive' },
    ],
  },
  {
    title: 'Borders & Inputs',
    swatches: [
      { name: 'border', description: 'Border color' },
      { name: 'input', description: 'Input border/bg' },
      { name: 'ring', description: 'Focus ring color' },
    ],
  },
]

const buttonVariants = [
  'default',
  'secondary',
  'destructive',
  'outline',
  'ghost',
  'link',
] as const

const inputClass =
  'w-full rounded-md border border-input bg-background px-3 py-2 focus:outline-none focus:ring-2 focus:ring-ring'
---

<Layout
  title="Theme Showcase - Steve Greco"
  description="Visual showcase of the site's color theme and design tokens"
  noindex
>
  <div class="mx-auto max-w-5xl">
    <h1 class="mb-2 text-4xl font-bold">Theme Showcase</h1>
    <p class="mb-8 text-muted-foreground">
      Semantic colors and components. Primitive palettes live on
      <a href="/design-tokens" class="text-primary hover:underline"
        >/design-tokens</a
      >.
    </p>

    {
      colorGroups.map((group) => (
        <section class="mb-12">
          <h2 class="mb-4 text-2xl font-semibold">{group.title}</h2>
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {group.swatches.map((swatch) => (
              <div class="rounded-lg border p-4">
                <div
                  class="mb-2 h-24 w-full rounded border"
                  style={`background-color: var(--color-${swatch.name})`}
                />
                <p class="font-mono text-sm">--color-{swatch.name}</p>
                <p class="text-xs text-muted-foreground">
                  {swatch.description}
                </p>
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-semibold">Typography</h2>
      <div class="space-y-4 rounded-lg border bg-card p-6">
        <p class="text-4xl font-bold">Heading 1</p>
        <p class="text-3xl font-semibold">Heading 2</p>
        <p class="text-2xl font-semibold">Heading 3</p>
        <p class="text-xl font-semibold">Heading 4</p>
        <p class="text-base">
          This is regular body text. The quick brown fox jumps over the lazy
          dog.
        </p>
        <p class="text-sm text-muted-foreground">
          This is small muted text. Often used for captions or secondary
          information.
        </p>
        <p class="font-mono text-sm">This is monospace text.</p>
      </div>
    </section>

    <section class="mb-12 space-y-8">
      <h2 class="text-2xl font-semibold">Components</h2>

      <div>
        <h3 class="mb-3 text-lg font-semibold">Card</h3>
        <Card title="Card title">
          <p class="text-sm text-muted-foreground">
            Uses <code>--card</code> background with
            <code>--card-foreground</code> text.
          </p>
        </Card>
      </div>

      <div>
        <h3 class="mb-3 text-lg font-semibold">Buttons</h3>
        <div class="flex flex-wrap items-start gap-3">
          {
            buttonVariants.map((variant) => (
              <button type="button" class={buttonClassName({ variant })}>
                {variant}
              </button>
            ))
          }
          <button type="button" class={buttonClassName({})} disabled>
            disabled
          </button>
        </div>
      </div>

      <div>
        <h3 class="mb-3 text-lg font-semibold">Form Inputs</h3>
        <div class="max-w-md space-y-4">
          <div>
            <label for="theme-input" class="mb-1.5 block text-sm font-medium"
              >Default input</label
            >
            <input
              id="theme-input"
              type="text"
              placeholder="Enter text..."
              class={inputClass}
            />
          </div>
          <div>
            <label
              for="theme-input-disabled"
              class="mb-1.5 block text-sm font-medium">Disabled input</label
            >
            <input
              id="theme-input-disabled"
              type="text"
              placeholder="Disabled..."
              disabled
              class={`${inputClass} cursor-not-allowed bg-muted opacity-50`}
            />
          </div>
        </div>
      </div>

      <div>
        <h3 class="mb-3 text-lg font-semibold">Alerts & Badges</h3>
        <div class="space-y-3">
          <div class="rounded border-l-4 border-primary bg-accent p-4">
            <p class="mb-1 font-medium">Info alert</p>
            <p class="text-sm text-muted-foreground">
              Uses --primary for the accent border
            </p>
          </div>
          <div class="rounded border-l-4 border-destructive bg-muted p-4">
            <p class="mb-1 font-medium">Error alert</p>
            <p class="text-sm text-muted-foreground">
              Uses --destructive for the accent border
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            <span
              class="rounded-full bg-primary px-2.5 py-0.5 text-xs font-medium text-primary-foreground"
              >Primary badge</span
            >
            <span
              class="rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground"
              >Secondary badge</span
            >
            <span
              class="rounded-full bg-muted px-2.5 py-0.5 text-xs font-medium text-muted-foreground"
              >Muted badge</span
            >
          </div>
        </div>
      </div>

      <div>
        <h3 class="mb-3 text-lg font-semibold">Code Block</h3>
        <pre
          class="rounded-lg border bg-muted p-4 text-sm"><code>{`const theme = {
  background: 'var(--color-background)',
  foreground: 'var(--color-foreground)',
  primary: 'var(--color-primary)',
  ring: 'var(--color-ring)',
}`}</code></pre>
      </div>
    </section>
  </div>
</Layout>
