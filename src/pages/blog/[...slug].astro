---
import { Image } from 'astro:assets'
import FormattedDate from '@/components/FormattedDate.astro'
import Prose from '@/components/Prose.astro'
import Layout from '@/layouts/Layout.astro'
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { getReadingTime } from '@/lib/reading-time'

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog')
  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const { Content } = await render(entry)
const readingTime = getReadingTime(entry.body)
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  image={`/blog/${entry.id}.png`}
  type="article"
>
  <article class="max-w-article mx-auto py-4 md:py-6">
    <a
      href="/blog"
      class="text-sm font-mono text-muted-foreground hover:text-primary transition-colors"
    >
      &larr; back to writing
    </a>

    <header class="mt-8 mb-10">
      <div
        class="flex items-center gap-2 text-xs font-mono text-muted-foreground mb-4"
      >
        <FormattedDate date={entry.data.date} />
        <span>&middot;</span>
        <span>{readingTime} min read</span>
      </div>
      <h1
        class="text-3xl md:text-5xl font-bold tracking-tight leading-tight mb-4"
      >
        {entry.data.title}
      </h1>
      {
        entry.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {entry.data.tags.map((tag) => (
              <span class="text-xs font-mono px-2.5 py-1 bg-muted text-muted-foreground rounded-full">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </header>

    {
      entry.data.image && (
        <Image
          class="w-full rounded-lg mb-10 object-cover"
          src={entry.data.image}
          alt={entry.data.title}
        />
      )
    }

    <Prose>
      <Content />
    </Prose>
  </article>
</Layout>
