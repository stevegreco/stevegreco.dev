---
import { getCollection } from 'astro:content'
import { SquareCode, Code } from '@lucide/astro'
import Card from '@/components/ui/Card.astro'
import TechLogo from '@/components/TechLogo.astro'

const projects = await getCollection('projects')
---

<Card title="Projects">
  <SquareCode slot="icon" aria-hidden="true" />
  {
    projects.map((project) => {
      return (
        <a
          class="w-full rounded-lg p-4"
          target="_blank"
          rel="noopener noreferrer"
          href={project.data.repo_url}
        >
          <div class="lg:flex justify-start gap-y-4 lg:gap-4">
            <div class="w-full">
              <h3 class="text-foreground text-lg">{project.data.title}</h3>
              <p class="text-sm text-muted-foreground">
                {project.data.description}
              </p>
              <div class="mt-2 flex gap-2 justify-between items-center">
                <ul class="flex justify-center items-center gap-2">
                  {project.data.tech.map((tech) => (
                    <li>
                      <TechLogo tech={tech} />
                    </li>
                  ))}
                </ul>
                <div class="flex justify-start items-center gap-2 text-sm">
                  <Code aria-hidden="true" />
                  github.com
                </div>
              </div>
            </div>
          </div>
        </a>
      )
    })
  }
  <div class="mt-2 flex items-center">
    <span class="text-muted-foreground text-sm"
      >More projects coming soon...</span
    >
  </div>
</Card>
