---
import { Briefcase, Download } from '@lucide/astro'
import JobEntry from './JobEntry.astro'
import Card from '@/components/ui/Card.astro'
import LinkButton from '@/components/ui/LinkButton.astro'
---

<Card title="Work">
  <Briefcase slot="icon" aria-hidden="true" />
  <div class="grid gap-6 py-4 md:gap-8">
    <JobEntry
      date="2024 - Present"
      title="Senior Software Engineer IV"
      company="Stratfield Consulting"
    />

    <div class="space-y-4">
      <p
        class="text-xs font-mono text-muted-foreground uppercase tracking-wide"
      >
        United States Steel Corporation
      </p>
      <div class="grid gap-4 pl-3 border-l border-border">
        <JobEntry
          date="2021 - 2024"
          title="Senior Software Engineer & Tech Lead"
        />
        <JobEntry date="2017 - 2021" title="Software Engineer III" />
        <JobEntry date="2015 - 2017" title="Software Engineer II" />
        <JobEntry date="2014 - 2015" title="Software Engineer I" />
        <JobEntry date="2013 - 2014" title="Software Engineer Co-op" />
      </div>
    </div>

    <LinkButton href="/Resume.pdf" target="_blank">
      Download Resume <Download aria-hidden="true" />
    </LinkButton>
  </div>
</Card>
